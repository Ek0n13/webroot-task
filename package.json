{
  "name": "article-intelligence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @article/web --filter @article/worker dev",
    "dev:web": "pnpm --filter @article/web dev",
    "dev:worker": "pnpm --filter @article/worker dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @article/web preview",
    "worker:start": "pnpm --filter @article/worker start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @article/db migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
