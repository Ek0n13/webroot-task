# Server-only credential. Create .env.local and replace this value.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Required model ID. This example supports structured outputs and low-effort reasoning.
OPENROUTER_MODEL=google/gemini-3.8-flash

# Required connection URL. Matches local Docker Compose; use separate credentials in production.
DATABASE_URL=postgresql://article:article_local_only@localhost:5432/article_intelligence

# Required number of concurrent analyses per worker process (1-8).
WORKER_CONCURRENCY=2
